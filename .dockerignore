# Build / dep artifacts — regenerated inside the container.
_build/
deps/
assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json

# Local-only files.
.elixir_ls/
.idea/
*.iml
.envrc
.env
.env.*
erl_crash.dump

# Tests / fixtures aren't needed for the prod release.
test/
cover/
tmp/

# Covers uploaded or fetched in development.
priv/uploads/

# VCS / CI metadata isn't needed in the image.
.git/
.gitignore
.forgejo/
.github/
