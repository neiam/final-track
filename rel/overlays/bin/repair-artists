#!/bin/sh
# Move plays recorded under a player's subtitle as the artist
# ("Cage The Elephant • Tell Me I'm Pretty • YouTube Music") onto the real
# artist and album. A dry run unless --apply.
#   bin/repair-artists
#   bin/repair-artists --apply
set -eu

export REPAIR_APPLY=false
case "${1:-}" in
  --apply) export REPAIR_APPLY=true ;;
  "") ;;
  *) echo "usage: $0 [--apply]" >&2; exit 2 ;;
esac

cd -P -- "$(dirname -- "$0")"
exec ./final_track eval FinalTrack.Release.repair_artists
